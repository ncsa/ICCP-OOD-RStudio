#!/usr/bin/env bash

#
# Start RStudio
#

# Purge the module environment to avoid conflicts
hostname

module purge
module load default-s11

# Check if we have a GPU
if [ -n "$CUDA_VISIBLE_DEVICES" ]; then
	APPTAINER_GPU_ENABLE="--nv"
else
	APPTAINER_GPU_ENABLE=""
fi

env

# Launch RStudio
set -x
## Test Some Variables
echo $port
myUSER="${USER}"
echo $myUSER
myHOME="${HOME}"
echo $myHOME
## RStudio Temp Folders
mkdir -p $myHOME/ondemand/data/sys/dashboard/batch_connect/sys/rstudio/tmp
mkdir -p $myHOME/ondemand/data/sys/dashboard/batch_connect/sys/rstudio/var/lib
mkdir -p $myHOME/ondemand/data/sys/dashboard/batch_connect/sys/rstudio/var/run
myTMP="$myHOME/ondemand/data/sys/dashboard/batch_connect/sys/rstudio/tmp"
myVARLIB="$myHOME/ondemand/data/sys/dashboard/batch_connect/sys/rstudio/var/lib"
myVARRUN="$myHOME/ondemand/data/sys/dashboard/batch_connect/sys/rstudio/var/run"
## Run Container

apptainer exec \
        --bind /scratch:/scratch \
        --bind /sw:/sw \
        --bind /u:/u \
        --bind /taiga:/taiga \
        --bind /projects:/projects \
        --bind /etc/profile.d:/etc/profile.d \
	--bind $myTMP:/tmp \
        --bind $myVARLIB:/var/lib/rstudio-server \
        --bind $myVARRUN:/var/run/rstudio-server \
	/sw/apps/ood/rocker_rstudio_20251017/rstudio_latest.sif rserver --www-address=0.0.0.0 --www-port=$port --server-user "$myUSER"
